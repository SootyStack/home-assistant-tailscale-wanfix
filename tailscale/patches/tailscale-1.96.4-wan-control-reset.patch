+func TestResetNoiseClient(t *testing.T) {
+	tr := new(closeTrackingTransport)
+	nc := &ts2021.Client{
+		Client: &http.Client{Transport: tr},
+	}
+	d := &Direct{
+		logf:        t.Logf,
+		noiseClient: nc,
+	}
+
+	d.resetNoiseClient()
+
+	if !tr.closed.Load() {
+		t.Fatal("old Noise transport was not closed")
+	}
+	if d.noiseClient != nil {
+		t.Fatal("old Noise client was retained")
+	}
+}
