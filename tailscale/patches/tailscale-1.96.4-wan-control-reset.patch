+// resetNoiseClient closes the active Noise connection pool and makes future
+// control requests create a fresh client. It leaves authentication, prefs, and
+// the most recently received network map untouched.
+func (c *Direct) resetNoiseClient() {
+	c.mu.Lock()
+	nc := c.noiseClient
+	c.noiseClient = nil
+	c.mu.Unlock()
+
+	if nc != nil {
+		if err := nc.Close(); err != nil {
+			c.logf("closing stale control transport: %v", err)
+		}
+	}
+}
