+func TestUpdateEndpointsResetsControlTransportForNewSTUNIPv4(t *testing.T) {
+	stun := func(addr string) tailcfg.Endpoint {
+		return tailcfg.Endpoint{
+			Addr: netip.MustParseAddrPort(addr),
+			Type: tailcfg.EndpointSTUN,
+		}
+	}
+
+	tr := new(closeTrackingTransport)
+	nc := &ts2021.Client{
+		Client: &http.Client{Transport: tr},
+	}
+	d := &Direct{
+		logf:        t.Logf,
+		noiseClient: nc,
+	}
+	oldMapCtx, oldMapCancel := context.WithCancel(context.Background())
+	defer oldMapCancel()
+	c := &Auto{
+		direct:          d,
+		logf:            t.Logf,
+		updateCh:        make(chan struct{}, 1),
+		loggedIn:        true,
+		haveReceivedMap: true,
+		mapCtx:          oldMapCtx,
+		mapCancel:       oldMapCancel,
+	}
+
+	c.UpdateEndpoints([]tailcfg.Endpoint{stun("198.51.100.10:41641")})
+	<-c.updateCh
+	c.UpdateEndpoints([]tailcfg.Endpoint{stun("198.51.100.10:51234")})
+	<-c.updateCh
+
+	if tr.closed.Load() {
+		t.Fatal("port-only change closed the control transport")
+	}
+
+	c.UpdateEndpoints([]tailcfg.Endpoint{
+		stun("203.0.113.20:42345"),
+		stun("198.51.100.10:51234"),
+	})
+
+	select {
+	case <-oldMapCtx.Done():
+	default:
+		t.Fatal("old map context was not canceled")
+	}
+	select {
+	case <-c.mapCtx.Done():
+		t.Fatal("replacement map context is already canceled")
+	default:
+	}
+	if !tr.closed.Load() {
+		t.Fatal("old control transport was not closed")
+	}
+	if d.noiseClient != nil {
+		t.Fatal("old Noise client was retained")
+	}
+	if got := len(c.updateCh); got != 1 {
+		t.Fatalf("queued updates = %d, want 1", got)
+	}
+}
