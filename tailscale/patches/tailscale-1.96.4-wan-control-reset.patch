+// noteSTUNEndpointIPs records the IPs in STUN-discovered endpoints and reports
+// whether a newly observed IP should force a fresh control transport.
+//
+// Port-only NAT rebinding is deliberately ignored. Empty STUN results do not
+// erase the baseline, and the first non-empty result only establishes it.
+func (c *Auto) noteSTUNEndpointIPs(endpoints []tailcfg.Endpoint) bool {
+	current := make(map[netip.Addr]struct{})
+	for _, ep := range endpoints {
+		if ep.Type != tailcfg.EndpointSTUN {
+			continue
+		}
+		ip := ep.Addr.Addr().Unmap()
+		if ip.Is4() {
+			current[ip] = struct{}{}
+		}
+	}
+	if len(current) == 0 {
+		return false
+	}
+
+	c.mu.Lock()
+	defer c.mu.Unlock()
+
+	var hasNewIP bool
+	for ip := range current {
+		if _, ok := c.lastSTUNEndpointIPv4s[ip]; !ok {
+			hasNewIP = true
+			break
+		}
+	}
+	hadBaseline := len(c.lastSTUNEndpointIPv4s) != 0
+	c.lastSTUNEndpointIPv4s = current
+
+	return hadBaseline &&
+		hasNewIP &&
+		c.loggedIn &&
+		c.haveReceivedMap &&
+		!c.paused &&
+		!c.closed
 }
 
