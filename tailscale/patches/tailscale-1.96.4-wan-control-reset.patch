+// restartMapWithFreshControlTransport is like restartMap, but also closes the
+// Noise connection pool so the next map request must establish a new
+// underlying connection. This is needed when an upstream NAT change silently
+// blackholes an otherwise healthy-looking control connection.
+func (c *Auto) restartMapWithFreshControlTransport(reason string) {
+	c.mu.Lock()
+	c.cancelMapCtxLocked()
+	synced := c.inMapPoll
+	c.direct.resetNoiseClient()
+	c.mu.Unlock()
+
+	c.logf("[v1] restartMap: fresh control transport; reason=%s synced=%v", reason, synced)
+	c.updateControl()
+}
