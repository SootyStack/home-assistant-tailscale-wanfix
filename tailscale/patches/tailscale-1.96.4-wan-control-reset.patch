+func TestSTUNEndpointIPChangeResetDecision(t *testing.T) {
+	stun := func(addr string) tailcfg.Endpoint {
+		return tailcfg.Endpoint{
+			Addr: netip.MustParseAddrPort(addr),
+			Type: tailcfg.EndpointSTUN,
+		}
+	}
+	local := func(addr string) tailcfg.Endpoint {
+		return tailcfg.Endpoint{
+			Addr: netip.MustParseAddrPort(addr),
+			Type: tailcfg.EndpointLocal,
+		}
+	}
+
+	c := &Auto{loggedIn: true, haveReceivedMap: true}
+
+	if c.noteSTUNEndpointIPs([]tailcfg.Endpoint{local("192.0.2.10:41641")}) {
+		t.Fatal("local-only endpoints unexpectedly requested a reset")
+	}
+	if c.noteSTUNEndpointIPs([]tailcfg.Endpoint{stun("198.51.100.10:41641")}) {
+		t.Fatal("initial STUN IP unexpectedly requested a reset")
+	}
+	if c.noteSTUNEndpointIPs([]tailcfg.Endpoint{stun("198.51.100.10:51234")}) {
+		t.Fatal("port-only change unexpectedly requested a reset")
+	}
+	if c.noteSTUNEndpointIPs([]tailcfg.Endpoint{stun("[2001:db8::10]:41641")}) {
+		t.Fatal("IPv6-only change unexpectedly requested a reset")
+	}
+	if !c.noteSTUNEndpointIPs([]tailcfg.Endpoint{
+		stun("203.0.113.20:42345"),
+		stun("198.51.100.10:51234"),
+	}) {
+		t.Fatal("new STUN IP did not request a reset")
+	}
+	if c.noteSTUNEndpointIPs([]tailcfg.Endpoint{
+		stun("203.0.113.20:42999"),
+		stun("198.51.100.10:59999"),
+	}) {
+		t.Fatal("known STUN IPs unexpectedly requested another reset")
+	}
+	if c.noteSTUNEndpointIPs([]tailcfg.Endpoint{stun("203.0.113.20:42999")}) {
+		t.Fatal("cached endpoint removal unexpectedly requested a reset")
+	}
+
+	c.haveReceivedMap = false
+	if c.noteSTUNEndpointIPs([]tailcfg.Endpoint{stun("192.0.2.30:41641")}) {
+		t.Fatal("pre-netmap STUN IP change unexpectedly requested a reset")
+	}
+
+	c.haveReceivedMap = true
+	c.paused = true
+	if c.noteSTUNEndpointIPs([]tailcfg.Endpoint{stun("192.0.2.31:41641")}) {
+		t.Fatal("paused client unexpectedly requested a reset")
+	}
+
+	c.paused = false
+	c.closed = true
+	if c.noteSTUNEndpointIPs([]tailcfg.Endpoint{stun("192.0.2.32:41641")}) {
+		t.Fatal("closed client unexpectedly requested a reset")
+	}
+}
