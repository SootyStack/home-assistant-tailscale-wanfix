+// takeNoiseClient removes and returns the current Noise client without closing
+// it. A concurrent getNoiseClient still creating a client is safe:
+// ts2021.NewClient does not dial, so it has no connection to the old path.
+func (c *Direct) takeNoiseClient() *ts2021.Client {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+
+	nc := c.noiseClient
+	c.noiseClient = nil
+	return nc
+}
+
+// dropNoiseClient closes nc and, if it is still the current Noise client,
+// forgets it so the next request dials a fresh connection. A late watchdog
+// must not discard a replacement installed by another recovery trigger.
+func (c *Direct) dropNoiseClient(nc *ts2021.Client) {
+	c.mu.Lock()
+	if c.noiseClient == nc {
+		c.noiseClient = nil
+	}
+	c.mu.Unlock()
+	if err := nc.Close(); err != nil {
+		c.logf("closing stale control connection: %v", err)
+	}
+}
