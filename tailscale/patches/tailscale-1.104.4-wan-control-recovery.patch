index 0000000..9de6bd1
--- /dev/null
+++ b/control/controlclient/watchdog_test.go
@@ -0,0 +1,300 @@
+// Copyright (c) Tailscale Inc & contributors
+// SPDX-License-Identifier: BSD-3-Clause
+
+package controlclient
+
+import (
+	"context"
+	"net"
+	"net/http"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"tailscale.com/control/ts2021"
+	"tailscale.com/tailcfg"
+	"tailscale.com/tstest"
+	"tailscale.com/tstest/integration/testcontrol"
+	"tailscale.com/tstime"
+)
+
+// blackholeConn is a net.Conn that can be made to behave like a TCP
+// connection whose upstream NAT mapping was flushed: writes appear to
+// succeed, reads never return data, and no RST or FIN ever arrives.
+type blackholeConn struct {
+	net.Conn
+	dead      atomic.Bool
+	closeOnce sync.Once
+	closed    chan struct{}
+
+	// onSwallow, if non-nil, is called for each write swallowed while dead.
+	onSwallow func()
+}
+
+func (c *blackholeConn) Read(p []byte) (int, error) {
+	if c.dead.Load() {
+		<-c.closed
+		return 0, net.ErrClosed
+	}
+	n, err := c.Conn.Read(p)
+	if c.dead.Load() {
+		<-c.closed
+		return 0, net.ErrClosed
+	}
+	return n, err
+}
+
+func (c *blackholeConn) Write(p []byte) (int, error) {
+	if c.dead.Load() {
+		if c.onSwallow != nil {
+			c.onSwallow()
+		}
+		return len(p), nil
+	}
+	return c.Conn.Write(p)
+}
+
+func (c *blackholeConn) Close() error {
+	c.closeOnce.Do(func() { close(c.closed) })
+	return c.Conn.Close()
+}
+
+// TestMapWatchdogRedialsBlackholedConn verifies that after the map watchdog
+// fires on a connection that silently stopped delivering packets (as after an
+// ISP reconnect that assigns a new public IP), the next map request dials a
+// fresh control connection instead of reusing the dead one.
+// See tailscale/tailscale#12021.
+func TestMapWatchdogRedialsBlackholedConn(t *testing.T) {
+	var (
+		mu    sync.Mutex
+		conns []*blackholeConn
+
+		swallowOnce sync.Once
+		swallowed   = make(chan struct{}) // closed on first swallowed write
+	)
+	numDials := func() int {
+		mu.Lock()
+		defer mu.Unlock()
+		return len(conns)
+	}
+	d := newDirectForTestControlWithConnHook(t, &testcontrol.Server{}, func(c net.Conn) net.Conn {
+		bc := &blackholeConn{
+			Conn:      c,
+			closed:    make(chan struct{}),
+			onSwallow: func() { swallowOnce.Do(func() { close(swallowed) }) },
+		}
+		mu.Lock()
+		conns = append(conns, bc)
+		mu.Unlock()
+		return bc
+	})
+	clock := tstest.NewClock(tstest.ClockOpts{Start: time.Now()})
+	d.clock = clock
+
+	ctx, cancel := context.WithTimeout(t.Context(), 10*time.Second)
+	defer cancel()
+	if _, err := d.TryLogin(ctx, LoginEphemeral); err != nil {
+		t.Fatalf("TryLogin: %v", err)
+	}
+	if _, err := d.FetchNetMapForTest(ctx); err != nil {
+		t.Fatalf("initial FetchNetMapForTest: %v", err)
+	}
+
+	// Upstream NAT change: every existing control connection goes silent.
+	mu.Lock()
+	for _, c := range conns {
+		c.dead.Store(true)
+	}
+	mu.Unlock()
+	dialsBefore := numDials()
+
+	// The map request on the dead connection hangs until the watchdog fires.
+	errc := make(chan error, 1)
+	go func() {
+		_, err := d.FetchNetMapForTest(ctx)
+		errc <- err
+	}()
+	// sendMapRequest arms the watchdog before it sends the request, so once
+	// the request's first write is swallowed, a single advance fires it.
+	select {
+	case <-swallowed:
+	case err := <-errc:
+		t.Fatalf("map request returned before reaching the dead connection: %v", err)
+	case <-ctx.Done():
+		t.Fatal("map request never wrote to the dead connection")
+	}
+	clock.Advance(watchdogTimeout + time.Second)
+	var err error
+	select {
+	case err = <-errc:
+	case <-ctx.Done():
+		t.Fatal("map request on blackholed connection never returned")
+	}
+	if err == nil {
+		t.Fatal("map request on blackholed connection unexpectedly succeeded")
+	}
+
+	// The network path itself is fine again; only the old connection is dead.
+	// Without advancing the clock, the next request must succeed promptly.
+	fetchCtx, fetchCancel := context.WithTimeout(t.Context(), 5*time.Second)
+	defer fetchCancel()
+	if _, err := d.FetchNetMapForTest(fetchCtx); err != nil {
+		t.Fatalf("FetchNetMapForTest after watchdog: %v (dials=%d, before blackhole=%d)", err, numDials(), dialsBefore)
+	}
+	if got := numDials(); got <= dialsBefore {
+		t.Errorf("dials = %d; want a new connection after watchdog (had %d)", got, dialsBefore)
+	}
+}
+
+// streamWatchdogClock reports when the watchdog is rearmed for the read after
+// the first streamed map. This lets the test advance fake time only once the
+// response has been processed; the watchdog is stopped during that processing.
+type streamWatchdogClock struct {
+	*tstest.Clock
+	readingNext chan struct{}
+}
+
+func (c *streamWatchdogClock) NewTimer(d time.Duration) (tstime.TimerController, <-chan time.Time) {
+	timer, ch := c.Clock.NewTimer(d)
+	if d == watchdogTimeout {
+		return &streamWatchdogTimer{TimerController: timer, readingNext: c.readingNext}, ch
+	}
+	return timer, ch
+}
+
+type streamWatchdogTimer struct {
+	tstime.TimerController
+	resets      int
+	readingNext chan struct{}
+}
+
+func (t *streamWatchdogTimer) Reset(d time.Duration) bool {
+	active := t.TimerController.Reset(d)
+	t.resets++
+	// sendMapRequest resets after the HTTP headers, before the first map read,
+	// and then before the second map read.
+	if t.resets == 3 {
+		select {
+		case t.readingNext <- struct{}{}:
+		default:
+		}
+	}
+	return active
+}
+
+func TestMapWatchdogRedialsEstablishedStream(t *testing.T) {
+	var mu sync.Mutex
+	var conns []*blackholeConn
+	tc := &testcontrol.Server{}
+	tc.AltMapStream = func(ctx context.Context, w testcontrol.MapStreamWriter, req *tailcfg.MapRequest) {
+		response, err := tc.MapResponse(req)
+		if err != nil {
+			t.Errorf("MapResponse: %v", err)
+			return
+		}
+		if err := w.SendMapMessage(response); err != nil {
+			t.Errorf("SendMapMessage: %v", err)
+			return
+		}
+		if req.Stream {
+			<-ctx.Done()
+		}
+	}
+	d := newDirectForTestControlWithConnHook(t, tc, func(c net.Conn) net.Conn {
+		bc := &blackholeConn{Conn: c, closed: make(chan struct{})}
+		mu.Lock()
+		conns = append(conns, bc)
+		mu.Unlock()
+		return bc
+	})
+	clock := &streamWatchdogClock{
+		Clock:       tstest.NewClock(tstest.ClockOpts{Start: time.Now()}),
+		readingNext: make(chan struct{}, 1),
+	}
+	d.clock = clock
+	ctx, cancel := context.WithTimeout(t.Context(), 10*time.Second)
+	defer cancel()
+	if _, err := d.TryLogin(ctx, LoginEphemeral); err != nil {
+		t.Fatalf("TryLogin: %v", err)
+	}
+	nu := &rememberLastNetmapUpdater{done: make(chan any, 1)}
+	errc := make(chan error, 1)
+	go func() { errc <- d.PollNetMap(ctx, nu) }()
+	select {
+	case <-nu.done:
+	case <-ctx.Done():
+		t.Fatal("stream never delivered its first map")
+	}
+	select {
+	case <-clock.readingNext:
+	case <-ctx.Done():
+		t.Fatal("stream never rearmed the watchdog after its first map")
+	}
+
+	mu.Lock()
+	dialsBefore := len(conns)
+	for _, c := range conns {
+		c.dead.Store(true)
+	}
+	mu.Unlock()
+	clock.Advance(watchdogTimeout + time.Second)
+	select {
+	case err := <-errc:
+		if err == nil {
+			t.Fatal("blackholed stream unexpectedly succeeded")
+		}
+	case <-ctx.Done():
+		t.Fatal("watchdog did not stop the established blackholed stream")
+	}
+
+	fetchCtx, fetchCancel := context.WithTimeout(t.Context(), 5*time.Second)
+	defer fetchCancel()
+	if _, err := d.FetchNetMapForTest(fetchCtx); err != nil {
+		t.Fatalf("FetchNetMapForTest after streaming watchdog: %v", err)
+	}
+	mu.Lock()
+	dialsAfter := len(conns)
+	mu.Unlock()
+	if dialsAfter <= dialsBefore {
+		t.Fatalf("dials = %d; want a fresh connection after %d", dialsAfter, dialsBefore)
+	}
+}
+
+// A late watchdog must close its old client without removing a replacement,
+// including when several requests on the old connection time out together.
+func TestDropNoiseClientConcurrentReplacement(t *testing.T) {
+	oldTransport, newTransport := new(closeRecorder), new(closeRecorder)
+	oldClient := &ts2021.Client{Client: &http.Client{Transport: oldTransport}}
+	newClient := &ts2021.Client{Client: &http.Client{Transport: newTransport}}
+	d := &Direct{logf: t.Logf, noiseClient: oldClient}
+	start := make(chan struct{})
+	var wg sync.WaitGroup
+	for range 32 {
+		wg.Go(func() {
+			<-start
+			d.dropNoiseClient(oldClient)
+		})
+	}
+	wg.Go(func() {
+		<-start
+		d.mu.Lock()
+		d.noiseClient = newClient
+		d.mu.Unlock()
+	})
+	close(start)
+	wg.Wait()
+	if !oldTransport.closed.Load() {
+		t.Error("timed-out client was not closed")
+	}
+	if newTransport.closed.Load() {
+		t.Error("replacement client was closed by an old watchdog")
+	}
+	if d.noiseClient != newClient {
+		t.Fatal("replacement client was discarded by an old watchdog")
+	}
+	d.dropNoiseClient(newClient)
+	if d.noiseClient != nil || !newTransport.closed.Load() {
+		t.Fatal("current client was not discarded and closed")
+	}
+}
