#!/command/with-contenv bashio
# shellcheck shell=bash
export LOG_FD

readonly DATA_DIRECTORY="/data"
readonly BACKUP_DIRECTORY="/backup"
readonly TEMP_DIRECTORY="/tmp"
readonly COMPLETION_MARKER="${DATA_DIRECTORY}/.diagnostic-seed-complete"

declare backup_slug backup_archive="" source_selector source_addon_archive
declare workspace="" extracted_data addon_archive
declare candidate optional_marker=""

cleanup() {
  if [[ "${workspace}" == "${TEMP_DIRECTORY}"/tailscale-seed.* ]] && \
    [[ -d "${workspace}" ]]; then
    rm -rf -- "${workspace}"
  fi
}
trap cleanup EXIT

backup_slug=$(bashio::config "diagnostic_seed_backup")
source_selector=$(bashio::config "diagnostic_seed_source")
if ! bashio::var.has_value "${backup_slug}" && \
  { ! bashio::var.has_value "${source_selector}" || \
    [[ "${source_selector}" == "disabled" ]]; }; then
  exit 0
fi
if ! bashio::var.has_value "${backup_slug}"; then
  bashio::exit.nok "A diagnostic seed source requires a backup slug"
fi
if [[ ! "${backup_slug}" =~ ^[0-9a-f]{8}$ ]]; then
  bashio::exit.nok "The diagnostic seed backup slug is invalid"
fi

case "${source_selector}" in
  official)
    source_addon_archive="a0d7b954_tailscale.tar.gz"
    ;;
  local)
    source_addon_archive="local_tailscale.tar.gz"
    ;;
  disabled)
    bashio::exit.nok "A diagnostic seed backup requires an enabled source"
    ;;
  *)
    bashio::exit.nok "The diagnostic seed source is not supported"
    ;;
esac

if [[ -f "${COMPLETION_MARKER}" ]]; then
  bashio::log.info "Tailscale identity seed was already completed"
  exit 0
fi
if [[ -e "${DATA_DIRECTORY}/tailscaled.state" ]] || \
  [[ -e "${DATA_DIRECTORY}/state" ]]; then
  bashio::exit.nok \
    "Refusing to seed over an existing Tailscale identity without a completion marker"
fi

for candidate in \
  "${BACKUP_DIRECTORY}/${backup_slug}.tar" \
  "${BACKUP_DIRECTORY}/${backup_slug}.tar.gz";
do
  if [[ -f "${candidate}" ]]; then
    backup_archive="${candidate}"
    break
  fi
done
if ! bashio::var.has_value "${backup_archive}"; then
  bashio::exit.nok "The requested Tailscale seed backup was not found"
fi

workspace=$(mktemp -d "${TEMP_DIRECTORY}/tailscale-seed.XXXXXXXX")
if [[ "${workspace}" != "${TEMP_DIRECTORY}"/tailscale-seed.* ]] || \
  [[ ! -d "${workspace}" ]]; then
  bashio::exit.nok "Failed to create a safe temporary state import directory"
fi
mkdir -p "${workspace}/extracted"

if ! tar -xf "${backup_archive}" -C "${workspace}" "${source_addon_archive}"; then
  bashio::exit.nok \
    "The backup does not contain the selected Tailscale add-on archive"
fi
addon_archive="${workspace}/${source_addon_archive}"

if ! tar -tzf "${addon_archive}" | grep -Fxq "data/tailscaled.state"; then
  bashio::exit.nok "The backup does not contain a Tailscale identity state file"
fi
if ! tar -tzf "${addon_archive}" | grep -Eq "^data/state/?$"; then
  bashio::exit.nok "The backup does not contain the Tailscale state directory"
fi
if tar -tzf "${addon_archive}" | grep -Fxq "data/final_serve_reset_is_done"; then
  optional_marker="data/final_serve_reset_is_done"
fi

if ! tar -xzf "${addon_archive}" \
  -C "${workspace}/extracted" \
  "data/tailscaled.state" \
  "data/state" \
  ${optional_marker:+"${optional_marker}"};
then
  bashio::exit.nok "Failed to extract the allowlisted Tailscale state"
fi
extracted_data="${workspace}/extracted/data"

if [[ ! -f "${extracted_data}/tailscaled.state" ]] || \
  [[ -L "${extracted_data}/tailscaled.state" ]] || \
  [[ ! -s "${extracted_data}/tailscaled.state" ]];
then
  bashio::exit.nok "The extracted Tailscale identity state is not a regular non-empty file"
fi
if find "${extracted_data}/state" ! -type f ! -type d -print -quit | grep -q .; then
  bashio::exit.nok "The extracted Tailscale state contains an unsupported file type"
fi

cp -a "${extracted_data}/state" "${DATA_DIRECTORY}/state"
cp "${extracted_data}/tailscaled.state" "${DATA_DIRECTORY}/tailscaled.state"
if [[ -f "${extracted_data}/final_serve_reset_is_done" ]]; then
  cp \
    "${extracted_data}/final_serve_reset_is_done" \
    "${DATA_DIRECTORY}/final_serve_reset_is_done"
fi
chown -R \
  root:root \
  "${DATA_DIRECTORY}/state" \
  "${DATA_DIRECTORY}/tailscaled.state"
chmod 0600 "${DATA_DIRECTORY}/tailscaled.state"
chmod -R go-rwx "${DATA_DIRECTORY}/state"
if [[ -f "${DATA_DIRECTORY}/final_serve_reset_is_done" ]]; then
  chown root:root "${DATA_DIRECTORY}/final_serve_reset_is_done"
  chmod 0600 "${DATA_DIRECTORY}/final_serve_reset_is_done"
fi
sync

{
  printf 'source_backup=%s\n' "${backup_slug}"
  printf 'source_selector=%s\n' "${source_selector}"
  printf 'source_archive=%s\n' "${source_addon_archive}"
  printf 'completed_at=%s\n' "$(date -u +"%Y-%m-%dT%H:%M:%SZ")"
} > "${COMPLETION_MARKER}"
chmod 0600 "${COMPLETION_MARKER}"
sync

bashio::log.info "Existing Tailscale identity imported for the diagnostic add-on"
